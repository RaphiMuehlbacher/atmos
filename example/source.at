struct Wrapper(i32);

impl Wrapper {
    fn foo() {
        let w = Wrapper(3);
        let Self(inner) = w;
    }
}

enum Foo {
    Bar {
        baz: i32
    }
}

impl Foo {
    fn foo() {
        let a = Foo::Bar { baz: 3 };
        let Self::Bar { baz: b } = a;
        let a: i32 = b;
    }
}

