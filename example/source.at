fn panic() -> ! {
    return
}

enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    fn unwrap(self: Self) -> T {
        match self {
            Self::Some(inner) => inner,
            Self::None => panic(),
        }
    }

    fn unwrap_or(self: Self, default: T) -> T {
        match self {
            Self::Some(inner) => inner,
            Self::None => default,
        }
    }

    fn is_some(self: Self) -> bool {
        match self {
            Self::Some(_) => true,
            Self::None => false,
        }
    }


    fn map<U>(self: Self, f: fn(T) -> U) -> Option<U> {
        match self {
            Self::Some(inner) => Option::Some(f(inner)),
            Self::None => Option::None,
        }
    }
}

fn main() {
    let s = Option::Some(3);
    let i: i32 = s.unwrap();
    let b: bool = s.is_some();
}

